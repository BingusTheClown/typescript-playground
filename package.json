{
  "name": "typescript-playground",
  "version": "1.0.0",
  "description": "A playground for playing within a typescript env",
  "main": "index.js",
  "scripts": {
    "test:unit": "mocha --require ts-node/register test/unit/*.spec.ts",
    "test:integration": "mocha --require ts-node/register test/integration/*.spec.ts",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingusTheClown/typescript-playground.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/BingusTheClown/typescript-playground/issues"
  },
  "homepage": "https://github.com/BingusTheClown/typescript-playground#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
